{
  extends: [
    ':enableRenovate',
    ':semanticCommits',
    'config:best-practices',
  ],
  timezone: 'UTC',
  dependencyDashboard: {
    enabled: true,
  },
  platformCommit: 'enabled',
  prCreation: 'not-pending',
  automergeStrategy: 'squash',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  enabledManagers: [
    'npm',
    'github-actions',
    'docker-compose',
    'dockerfile',
    'devcontainer',
    'nix',
  ],
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'package.json',
      ],
      matchDepTypes: [
        'dependencies',
        'peerDependencies',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    {
      matchDepTypes: [
        'peerDependencies',
      ],
      rangeStrategy: 'widen',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchDepTypes: [
        'devDependencies',
      ],
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
    },
    {
      matchFileNames: [
        'example/**',
      ],
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'nix',
      ],
      groupName: 'nix flake inputs',
      schedule: [
        'on the first day of the month',
      ],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
      automerge: false,
    },
    {
      matchPackageNames: [
        'three',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'node-canvas-webgl',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      matchPackageNames: [
        'node',
      ],
      allowedVersions: '<23',
    },
    {
      matchFileNames: [
        'example/bots/package.json',
      ],
      matchPackageNames: [
        'prismarine-viewer',
        'gl',
        'canvas',
      ],
      groupName: 'renderer',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'dependency/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'dependency/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'dependency/patch',
      ],
    },
  ],
}
